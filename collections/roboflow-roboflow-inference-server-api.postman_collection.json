      "item": [
        {
          "id": "e0962964-472e-48ed-a4a5-9599b7e66b36",
          "name": "Legacy Infer From Request",
          "request": {
            "name": "Legacy Infer From Request",
            "description": {
              "content": "Legacy inference endpoint for object detection, instance segmentation, and classification.\n\nArgs:\n    background_tasks: (BackgroundTasks) pool of fastapi background tasks\n    dataset_id (str): ID of a Roboflow dataset corresponding to the model to use for inference OR workspace ID\n    version_id (str): ID of a Roboflow dataset version corresponding to the model to use for inference OR model ID\n    api_key (Optional[str], default None): Roboflow API Key passed to the model during initialization for artifact retrieval.\n    # Other parameters described in the function signature...\n\nReturns:\n    Union[InstanceSegmentationInferenceResponse, KeypointsDetectionInferenceRequest, ObjectDetectionInferenceResponse, ClassificationInferenceResponse, MultiLabelClassificationInferenceResponse, SemanticSegmentationInferenceResponse, Any]: The response containing the inference results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":dataset_id",
                ":version_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "Roboflow API Key that will be passed to the model during initialization for artifact retrieval"
                },
                {
                  "disabled": false,
                  "key": "confidence",
                  "value": "<number>",
                  "description": "The confidence threshold used to filter out predictions. Pass a float in [0, 1], or \"best\" to use F1-optimal thresholds from model evaluation, or \"default\" to use the model's built-in default."
                },
                {
                  "disabled": false,
                  "key": "keypoint_confidence",
                  "value": "0",
                  "description": "The confidence threshold used to filter out keypoints that are not visible based on model confidence"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "One of 'json' or 'image'. If 'json' prediction data is return as a JSON string. If 'image' prediction data is visualized and overlayed on the original input image."
                },
                {
                  "disabled": false,
                  "key": "image",
                  "value": "<string>",
                  "description": "The publically accessible URL of an image to use for inference."
                },
                {
                  "disabled": false,
                  "key": "image_type",
                  "value": "<string>",
                  "description": "One of base64 or numpy. Note, numpy input is not supported for Roboflow Hosted Inference."
                },
                {
                  "disabled": false,
                  "key": "labels",
                  "value": "<boolean>",
                  "description": "If true, labels will be include in any inference visualization."
                },
                {
                  "disabled": false,
                  "key": "mask_decode_mode",
                  "value": "<string>",
                  "description": "One of 'accurate' or 'fast'. If 'accurate' the mask will be decoded using the original image size. If 'fast' the mask will be decoded using the original mask size. 'accurate' is slower but more accurate."
                },
                {
                  "disabled": false,
                  "key": "tradeoff_factor",
                  "value": "<number>",
                  "description": "The amount to tradeoff between 0='fast' and 1='accurate'"
                },
                {
                  "disabled": false,
                  "key": "max_detections",
                  "value": "300",
                  "description": "The maximum number of detections to return. This is used to limit the number of predictions returned by the model. The model may return more predictions than this number, but only the top `max_detections` predictions will be returned."
                },
                {
                  "disabled": false,
                  "key": "overlap",
                  "value": "0.3",
                  "description": "The IoU threhsold that must be met for a box pair to be considered duplicate during NMS"
                },
                {
                  "disabled": false,
                  "key": "stroke",
                  "value": "1",
                  "description": "The stroke width used when visualizing predictions"
                },
                {
                  "disabled": false,
                  "key": "disable_preproc_auto_orient",
                  "value": "<boolean>",
                  "description": "If true, disables automatic image orientation"
                },
                {
                  "disabled": false,
                  "key": "disable_preproc_contrast",
                  "value": "<boolean>",
                  "description": "If true, disables automatic contrast adjustment"
                },
                {
                  "disabled": false,
                  "key": "disable_preproc_grayscale",
                  "value": "<boolean>",
                  "description": "If true, disables automatic grayscale conversion"
                },
                {
                  "disabled": false,
                  "key": "disable_preproc_static_crop",
                  "value": "<boolean>",
                  "description": "If true, disables automatic static crop"
                },
                {
                  "disabled": false,
                  "key": "disable_active_learning",
                  "value": "<boolean>",
                  "description": "If true, the predictions will be prevented from registration by Active Learning (if the functionality is enabled)"
                },
                {
                  "disabled": false,
                  "key": "active_learning_target_dataset",
                  "value": "<string>",
                  "description": "Parameter to be used when Active Learning data registration should happen against different dataset than the one pointed by model_id"
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "The source of the inference request"
                },
                {
                  "disabled": false,
                  "key": "source_info",
                  "value": "<string>",
                  "description": "The detailed source information of the inference request"
                },
                {
                  "disabled": false,
                  "key": "response_mask_format",
                  "value": "<string>",
                  "description": "The format of the prediction mask - polygon (default) or rle - applicable for instance segmentation models."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataset_id",
                  "description": "(Required) ID of a Roboflow dataset corresponding to the model to use for inference OR workspace ID"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "version_id",
                  "description": "(Required) ID of a Roboflow dataset version corresponding to the model to use for inference OR model ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
