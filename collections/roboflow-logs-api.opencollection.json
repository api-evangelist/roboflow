{
  "opencollection": "1.0.0",
  "info": {
    "name": "Roboflow Inference Server Logs API",
    "version": "1.3.8"
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Recent Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/logs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of log entries to return"
              },
              {
                "name": "level",
                "value": "",
                "type": "query",
                "description": "Filter by log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Return logs since this ISO timestamp"
              }
            ]
          },
          "docs": "Get recent application logs for debugging"
        }
      ]
    }
  ],
  "bundled": true
}